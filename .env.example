# Configuration du serveur SyncMusic.
#
# Copier ce fichier en `.env` a la racine et remplir les valeurs. `.env` est ignore
# par git et ne doit jamais y entrer: il contient le secret OAuth.
# Les scripts `npm start` et `npm run dev:server` le chargent tout seuls.

# Port du serveur. 8787 par defaut.
PORT=8787

# Adresse publique de l application. Sert a construire la redirect URI envoyee a
# Google et a controler l origine des connexions WebSocket. En developpement, c est
# l adresse que tu tapes vraiment dans le navigateur: http://localhost:5173 sous
# `npm run dev`, http://localhost:8787 sous `npm run serve`.
BASE_URL=http://localhost:5173

# Identifiants OAuth Google (console Google Cloud, Google Auth Platform > Clients).
# Sans eux, les routes de connexion n existent pas et l application reste entierement
# utilisable en invite (R3): c est un mode de fonctionnement normal, pas une panne.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fichier de la base SQLite. `data/syncmusic.db` par defaut, sous le dossier du projet.
# En production, doit pointer dans un volume persistant (deja regle dans fly.toml).
# DB_PATH=data/syncmusic.db
